# Neon: use the POOLED connection string (host contains "-pooler") for the app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Optional: Neon DIRECT (non-pooled) string used only by migrations. Falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:5173
TZ=America/Guatemala
# Google Drive (OAuth refresh token of the Google account that owns the Drive folders)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Alternative to the three above: service account JSON (raw JSON or base64). Needs a Shared Drive.
GOOGLE_SERVICE_ACCOUNT_JSON=
